# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_IDS=123456789,987654321

# Database Configuration (PostgreSQL)
POSTGRES_DB=btc_tracker_db
POSTGRES_USER=btc_user
POSTGRES_PASSWORD=btc_secure_password_123
POSTGRES_HOST=db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://btc_user:btc_secure_password_123@db:5432/btc_tracker_db

# Market Data / Binance
BINANCE_API_URL=https://data-api.binance.vision
PRICE_MONITOR_INTERVAL=5

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
AI_ANALYSIS_INTERVAL_MINUTES=60
AI_MANUAL_COOLDOWN_MINUTES=10

# Application Defaults
DEFAULT_TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO

